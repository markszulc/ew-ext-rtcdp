# Copy to .env (never commit it). Values come from an Adobe Developer Console project
# with the Experience Platform API and OAuth Server-to-Server credentials.
AEP_CLIENT_ID=
AEP_CLIENT_SECRET=
AEP_ORG_ID=XXXXXXXX@AdobeOrg
# Optional: scopes shown on the credential page in Developer Console
AEP_SCOPES=
# Comma-separated sandboxes the panel may read
ALLOWED_SANDBOXES=prod
# Comma-separated origins allowed to call the proxy, e.g. where the panel is hosted.
# Leave empty to allow any origin (the caller's IMS token is still required).
ALLOWED_ORIGINS=
# Optional: only accept IMS tokens issued to these client IDs
ALLOWED_CLIENT_IDS=
